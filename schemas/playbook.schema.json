{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciberseguridad-toolkit/schemas/playbook.schema.json",
  "title": "Ciberseguridad Toolkit - Front-matter de playbook",
  "description": "Metadatos obligatorios al inicio de cada playbook en Markdown.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "summary",
    "tags",
    "network",
    "inputs",
    "outputs",
    "version",
    "status",
    "last_reviewed"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PB-[A-Z]+-\\d{3}$",
      "description": "Identificador estable e inmutable."
    },
    "type": { "const": "playbook" },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 200,
      "description": "Una sola frase. Se usa en indices y en RAG."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "network": {
      "type": "string",
      "enum": ["none", "optional", "required"],
      "description": "none = 100% offline; optional = consulta externa opcional; required = obligatorio."
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Rutas relativas a herramientas usadas."
    },
    "severity_scope": {
      "type": "array",
      "items": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] }
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "review", "stable", "deprecated"] },
    "last_reviewed": { "type": "string", "format": "date" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" }
  }
}
